<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rasterises hob.svg into src\Hob.Cli\hob.ico. Run it with tools\gen-icons.ps1 after editing the SVG and commit
       the .ico: nothing in the build depends on this tool or on System.Drawing, which is Windows-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.7" />
  </ItemGroup>

</Project>
